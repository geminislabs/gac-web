{
	"name": "geminislabs-admin-control",
	"private": true,
	"version": "1.10.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "prettier --write . && eslint . --fix",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:unit": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"validate": "npm run lint && npm run check && npm run test:coverage && npm run build",
		"commitlint": "commitlint",
		"audit": "npm audit --audit-level=high",
		"scan:secrets": "bash scripts/gitleaks-scan.sh",
		"scan:osv": "bash scripts/osv-scan.sh"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24.19.2",
		"@vitest/coverage-v8": "^4.1.12",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^16.5.0",
		"happy-dom": "^21.0.4",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.1.13",
		"typescript": "^6.0.3",
		"vite": "^7.3.7",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@googlemaps/js-api-loader": "^2.1.3",
		"@googlemaps/markerclusterer": "^2.6.2"
	},
	"overrides": {
		"cookie": "^0.7.0",
		"esbuild": ">=0.28.1",
		"js-yaml": "~4.3.2"
	}
}
